# ==========================================
# VisionGuard AI — Backend Environment Template
# Copy this file to '.env' and fill in your actual credentials.
# ==========================================

# Project
PROJECT_NAME="VisionGuard AI"
VERSION="1.0.0"

# CORS Allowed Origins (Add your Vercel domain here when deploying!)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://your-frontend.vercel.app"

# Security & JWT
SECRET_KEY="your-secure-random-secret-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Email Verification & SMTP Secrets
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-16-digit-app-password"
SENDER_EMAIL="your-email@gmail.com"

# Neon Serverless Postgres Database Secrets
POSTGRES_SERVER="your-neon-hostname.aws.neon.tech"
POSTGRES_USER="neondb_owner"
POSTGRES_PASSWORD="your-neon-db-password"
POSTGRES_DB="neondb"
POSTGRES_PORT="5432"
